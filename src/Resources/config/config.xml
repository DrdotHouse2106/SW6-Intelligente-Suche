<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">

    <card>
        <title>Instant search</title>
        <title lang="de-DE">Sofortsuche</title>

        <input-field type="bool">
            <name>active</name>
            <label>Use instant search</label>
            <label lang="de-DE">Sofortsuche verwenden</label>
            <helpText lang="de-DE">Aus = Shopwares Standard-Suchvorschläge.</helpText>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="int">
            <name>productLimit</name>
            <label>Products per load step</label>
            <label lang="de-DE">Produkte pro Ladeschritt</label>
            <helpText lang="de-DE">Beim Scrollen werden automatisch weitere Produkte nachgeladen.</helpText>
            <defaultValue>24</defaultValue>
            <min>1</min>
            <max>48</max>
        </input-field>

        <input-field type="bool">
            <name>showCategories</name>
            <label>Show matching categories</label>
            <label lang="de-DE">Passende Kategorien anzeigen</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>showManufacturers</name>
            <label>Show brand filter</label>
            <label lang="de-DE">Filter „Marken“ anzeigen</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="int">
            <name>debounce</name>
            <label>Delay after typing (ms)</label>
            <label lang="de-DE">Wartezeit nach Tastendruck (ms)</label>
            <helpText lang="de-DE">Kleiner = schnellere Reaktion, größer = weniger Serverlast. Empfohlen: 150–250.</helpText>
            <defaultValue>180</defaultValue>
            <min>0</min>
            <max>1000</max>
        </input-field>
    </card>

    <card>
        <title>Start view</title>
        <title lang="de-DE">Startansicht (bevor etwas getippt wird)</title>

        <input-field type="textarea">
            <name>popularSearches</name>
            <label>Popular searches</label>
            <label lang="de-DE">Beliebte Suchanfragen</label>
            <helpText lang="de-DE">Eine Suchanfrage pro Zeile (oder durch Komma getrennt), z. B. chrom, scheinwerfer, rolldach. Maximal 12.</helpText>
        </input-field>

        <component name="sw-entity-multi-id-select">
            <name>highlightProducts</name>
            <entity>product</entity>
            <label>Highlight products</label>
            <label lang="de-DE">Highlight-Produkte</label>
            <helpText lang="de-DE">Werden als „Aktuelle Highlights“ mit Bild und Preis angezeigt.</helpText>
        </component>
    </card>
</config>
