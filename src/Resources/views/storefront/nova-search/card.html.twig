{# Produktkarte im Suchfenster – Variable: product #}
{% block nova_search_card %}
    {% set name = product.translated.name %}
    {% set price = product.calculatedPrice %}
    {% set isFrom = product.calculatedPrices|length > 1 or (product.childCount > 0 and product.variantListingConfig.displayParent) %}
    {% if product.calculatedPrices|length > 1 %}
        {% set price = product.calculatedPrices.last %}
    {% endif %}
    {% set hasListPrice = price.listPrice and price.listPrice.percentage > 0 %}

    {# Produktdaten im selben Format wie Shopwares Produktbox – für Tracking (GTM) und Lernen #}
    {% set productInformation = {
        id: product.id,
        name: name,
        brand: product.manufacturer.translated.name|default(''),
        price: product.calculatedPrice.unitPrice,
        sku: product.productNumber
    } %}

    <li class="nova-search-card-item" data-product-information="{{ productInformation|json_encode }}">
        <a class="nova-search-card nova-search-focusable" href="{{ seoUrl('frontend.detail.page', { productId: product.id }) }}">
            <span class="nova-search-card-media">
                {% if product.cover.media %}
                    {% sw_thumbnails 'nova-search-thumbnail' with {
                        media: product.cover.media,
                        sizes: { xs: '50vw', sm: '33vw', md: '25vw', default: '220px' },
                        attributes: { alt: name, loading: 'lazy', class: 'nova-search-card-img' }
                    } %}
                {% else %}
                    {% sw_icon 'placeholder' style { size: 'fluid' } %}
                {% endif %}

                {% if hasListPrice %}
                    <span class="nova-search-card-flag">-{{ price.listPrice.percentage|round }} %</span>
                {% endif %}
            </span>

            <span class="nova-search-card-title nova-search-hl">{{ name }}</span>

            {% if product.variation|length > 0 %}
                <span class="nova-search-card-variant">
                    {%- for v in product.variation %}{{ v.option }}{% if not loop.last %}, {% endif %}{% endfor -%}
                </span>
            {% endif %}

            {# Dynamische Lieferzeiten (Plugin „Dynamische Monats-Lieferzeiten“) – nur wenn installiert und
               dort „Versandtermin in Produkt-Listings anzeigen“ aktiv ist #}
            {% block nova_search_card_monthly_delivery %}
                {% set monthlyDelivery = product.extensions.monthlyDelivery ?? null %}
                {% if monthlyDelivery and monthlyDelivery.shipDateFormatted is defined and monthlyDelivery.shipDateFormatted
                    and config('MonthlyDeliveryPlugin.config.showInListing') %}
                    <span class="nova-search-card-delivery">
                        {{ 'novaSearch.monthlyDelivery'|trans({
                            '%weekday%': ('novaSearch.weekdayShort.' ~ monthlyDelivery.shipWeekday)|trans,
                            '%date%': monthlyDelivery.shipDateFormatted
                        }) }}
                    </span>
                {% endif %}
            {% endblock %}

            {# Bewertung (Sterne) #}
            {% if config('NovaSearch.config.cardRating') is not same as(false) and product.ratingAverage > 0 %}
                {% block nova_search_card_rating %}
                    {% set novaRating = product.ratingAverage|round(1) %}
                    <span class="nova-search-card-rating" title="{{ novaRating }} / 5" aria-label="{{ novaRating }} / 5">
                        <span class="nova-search-card-stars" style="--nova-rating: {{ (product.ratingAverage / 5 * 100)|round }}%" aria-hidden="true">★★★★★</span>
                    </span>
                {% endblock %}
            {% endif %}

            {# Verfügbarkeit: Hinweis nur, wenn das Produkt derzeit nicht bestellbar ist #}
            {% set novaAvailable = not product.isCloseout or product.availableStock >= product.minPurchase %}
            {% if config('NovaSearch.config.cardAvailability') is not same as(false) and not novaAvailable %}
                <span class="nova-search-card-soldout">{{ 'novaSearch.soldOut'|trans }}</span>
            {% endif %}

            <span class="nova-search-card-price">
                {% if isFrom %}{{ 'listing.listingTextFrom'|trans }} {% endif %}
                {{- price.unitPrice|currency }}{{ 'general.star'|trans|sw_sanitize }}
                {% if hasListPrice %}
                    <del class="nova-search-card-list-price">{{ price.listPrice.price|currency }}</del>
                {% endif %}
            </span>
        </a>

        {# „In den Warenkorb“ direkt im Suchfenster – wie Shopwares Produktbox (nur ohne Varianten-Auswahl) #}
        {% set novaBuy = config('NovaSearch.config.cardBuyButton') is not same as(false)
            and novaAvailable and product.calculatedPrices|length <= 1 and product.childCount <= 0 %}
        {% if novaBuy %}
            {% block nova_search_card_buy %}
                {% set id = product.id %}
                <form action="{{ path('frontend.checkout.line-item.add') }}" method="post" class="nova-search-card-buy" data-add-to-cart="true" data-nova-search-buy>
                    <input type="hidden" name="redirectTo" value="frontend.checkout.cart.page">
                    <input type="hidden" name="lineItems[{{ id }}][id]" value="{{ id }}">
                    <input type="hidden" name="lineItems[{{ id }}][referencedId]" value="{{ id }}">
                    <input type="hidden" name="lineItems[{{ id }}][type]" value="product">
                    <input type="hidden" name="lineItems[{{ id }}][stackable]" value="1">
                    <input type="hidden" name="lineItems[{{ id }}][removable]" value="1">
                    <input type="hidden" name="lineItems[{{ id }}][quantity]" value="{{ product.minPurchase ?: 1 }}">
                    <input type="hidden" name="product-name" value="{{ name }}">
                    <button type="submit" class="btn btn-buy nova-search-card-buy-btn nova-search-focusable" aria-label="{{ 'novaSearch.addToCartAria'|trans({ '%name%': name })|striptags }}">
                        {{ 'novaSearch.addToCart'|trans }}
                    </button>
                </form>
            {% endblock %}
        {% endif %}
    </li>
{% endblock %}
